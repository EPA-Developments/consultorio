{
  "name": "consultorio",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:bots && tsc && vite build",
    "build:bots": "npm run clean && tsc --project tsconfig-bots.json && node --no-warnings esbuild-script.mjs && tsx src/scripts/deploy-bots.ts",
    "clean": "rimraf dist",
    "ckm-doctor": "tsx src/scripts/ckm-doctor.ts",
    "ckm-bots-doctor": "tsx src/scripts/ckm-bots-doctor.ts",
    "dedupe-practitioners": "tsx src/scripts/dedupe-resources.ts",
    "dedupe-organizations": "tsx src/scripts/dedupe-resources.ts --type=Organization",
    "dev": "vite",
    "import-vsac": "tsx src/scripts/import-vsac-valuesets.ts",
    "localize-argentina": "tsx src/scripts/localize-argentina.ts",
    "upload-med-valueset": "tsx src/scripts/upload-medication-valueset.ts",
    "upload-condition-valueset": "tsx src/scripts/upload-condition-valueset.ts",
    "seed-ckm-demo": "tsx src/scripts/seed-ckm-demo.ts",
    "seed-biomarkers-demo": "tsx src/scripts/seed-biomarkers-demo.ts",
    "upload-biomarker-defs": "tsx src/scripts/upload-biomarker-definitions.ts",
    "verify-prevent": "tsx src/scripts/verify-prevent.ts",
    "verify-alerts": "tsx src/scripts/verify-alerts.ts",
    "verify-careplan": "tsx src/scripts/verify-careplan.ts",
    "deploy-bots-server": "tsx src/scripts/deploy-bots-server.ts",
    "upload-access-policy": "tsx src/scripts/upload-access-policy.ts",
    "access-policy-doctor": "tsx src/scripts/access-policy-doctor.ts",
    "upload-sdoh": "tsx src/scripts/upload-sdoh-questionnaire.ts",
    "upload-le8": "tsx src/scripts/upload-le8-questionnaires.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "refeps-doctor": "tsx src/scripts/refeps-doctor.ts",
    "invite-practitioners": "tsx src/scripts/invite-practitioners.ts",
    "snomed-subset": "tsx src/scripts/snomed-subset.ts",
    "snomed-marcas": "tsx src/scripts/snomed-marcas.ts",
    "snomed-vademecum": "tsx src/scripts/snomed-vademecum.ts",
    "project-map": "tsx src/scripts/project-map.ts"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@mantine/core": "8.3.6",
    "@mantine/hooks": "8.3.6",
    "@mantine/notifications": "8.3.6",
    "@medplum/bot-layer": "5.0.0",
    "@medplum/core": "5.0.0",
    "@medplum/definitions": "^5.1.17",
    "@medplum/eslint-config": "5.0.0",
    "@medplum/fhirtypes": "5.0.0",
    "@medplum/mock": "5.0.0",
    "@medplum/react": "5.0.0",
    "@tabler/icons-react": "3.35.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "22.18.13",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "chart.js": "4.5.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "esbuild": "0.25.11",
    "fast-glob": "3.3.3",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "react": "19.2.0",
    "react-chartjs-2": "5.3.1",
    "react-dom": "19.2.0",
    "react-router": "7.9.5",
    "rimraf": "6.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.6"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
